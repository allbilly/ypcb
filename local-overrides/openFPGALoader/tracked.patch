+static std::string fx2_usb_devices(libusb_context *ctx, uint16_t vid,
+		uint16_t uninit_pid, uint16_t init_pid)
+{
+	libusb_device **devices = nullptr;
+	const ssize_t count = libusb_get_device_list(ctx, &devices);
+	if (count < 0)
+		return std::string("enumeration failed: ") + libusb_error_name(count);
+
+	std::string result;
+	for (ssize_t i = 0; i < count; i++) {
+		libusb_device_descriptor desc;
+		if (libusb_get_device_descriptor(devices[i], &desc) != LIBUSB_SUCCESS ||
+				desc.idVendor != vid ||
+				(desc.idProduct != uninit_pid && desc.idProduct != init_pid))
+			continue;
+		char entry[96];
+		snprintf(entry, sizeof(entry), "%s%04x:%04x bus=%u address=%u",
+				result.empty() ? "" : ", ", desc.idVendor, desc.idProduct,
+				libusb_get_bus_number(devices[i]), libusb_get_device_address(devices[i]));
+		result += entry;
+	}
+	libusb_free_device_list(devices, 1);
+	return result.empty() ? "none" : result;
+}
