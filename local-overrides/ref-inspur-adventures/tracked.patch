--- a/scripts/xpcu_descriptor.py
+++ b/scripts/xpcu_descriptor.py
@@ -86,7 +86,6 @@ class IFACE(ctypes.Structure):
 
 
 class IFACE_DESC(ctypes.Structure):
-    _pack_ = 0  # natural alignment; matches libusb's struct
     _fields_ = [
         ("bLength", ctypes.c_uint8),
