+
+bool XilinxPlatformCableUSB::writeTMSTDI(const uint8_t *tms,
+		const uint8_t *tdi, uint8_t *tdo, uint32_t len)
+{
+	if (len == 0)
+		return true;
+
+	if (tdo)
+		memset(tdo, 0, (len + 7) / 8);
+
+	auto get_bit = [](const uint8_t *bits, uint32_t pos) -> uint8_t {
+		return bits ? ((bits[pos >> 3] >> (pos & 0x07)) & 0x01) : 0;
+	};
+
+	uint32_t i = 0;
+	while (i < len) {
+		if (xpcuTapInShift(_xvc_tap_state)) {
+			if (_nb_bit != 0 && write(nullptr, 0) < 0) {
+				printError("XPCU writeTMSTDI: pre-shift navigation flush failed");
+				return false;
+			}
+
+			const uint32_t start = i;
+			bool end_shift = false;
+			while (i < len && xpcuTapInShift(_xvc_tap_state)) {
+				const uint8_t tms_bit = get_bit(tms, i);
+				end_shift = tms_bit != 0;
+				_xvc_tap_state = xpcuNextTapState(_xvc_tap_state, tms_bit);
+				i++;
+				if (end_shift)
+					break;
+			}
+
+			const uint32_t seg_len = i - start;
+			const uint32_t seg_bytes = (seg_len + 7) / 8;
+			std::vector<uint8_t> tx(seg_bytes, 0);
+			std::vector<uint8_t> rx(seg_bytes, 0);
+			for (uint32_t bit = 0; bit < seg_len; bit++) {
+				if (get_bit(tdi, start + bit))
+					tx[bit >> 3] |= (1 << (bit & 0x07));
+			}
+
+			_curr_tms = 0;
+			if (writeTDI(tx.data(), tdo ? rx.data() : nullptr, seg_len,
+						end_shift) != static_cast<int>(seg_len)) {
+				char mess[128];
+				snprintf(mess, sizeof(mess),
+						"XPCU writeTMSTDI: shift segment failed start=%u len=%u end=%u",
+						start, seg_len, end_shift ? 1 : 0);
+				printError(mess);
+				return false;
+			}
+
+			if (tdo) {
+				for (uint32_t bit = 0; bit < seg_len; bit++) {
+					const uint32_t dst = start + bit;
+					if ((rx[bit >> 3] >> (bit & 0x07)) & 0x01)
+						tdo[dst >> 3] |= (1 << (dst & 0x07));
+				}
+			} else if (_nb_bit != 0 && write(nullptr, 0) < 0) {
+				printError("XPCU writeTMSTDI: final shift flush failed");
+				return false;
+			}
+
+			_curr_tms = get_bit(tms, i - 1);
+			_curr_tdi = get_bit(tdi, i - 1);
+			continue;
+		}
+
+		while (i < len && !xpcuTapInShift(_xvc_tap_state)) {
+			const uint8_t tms_bit = get_bit(tms, i);
+			const uint8_t tdi_bit = get_bit(tdi, i);
+			_curr_tms = tms_bit;
+			_curr_tdi = tdi_bit;
+			if (storeBit(_curr_tdi, _curr_tms, 1, 0)) {
+				if (write(nullptr, 0) < 0) {
+					printError("XPCU writeTMSTDI: navigation segment failed");
+					return false;
+				}
+			}
+			_xvc_tap_state = xpcuNextTapState(_xvc_tap_state, tms_bit);
+			i++;
+		}
+
+		if (_nb_bit != 0 && write(nullptr, 0) < 0) {
+			printError("XPCU writeTMSTDI: final navigation flush failed");
+			return false;
+		}
+	}
+
+	return true;
 }
 
